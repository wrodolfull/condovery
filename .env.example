# Backend-only connection from Supabase Dashboard > Connect.
# Use Session pooler (5432) for a persistent backend and Transaction pooler
# (6543) for serverless environments. Do not place these in NEXT_PUBLIC_*.
DATABASE_URL=postgresql://postgres.PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Supabase project (Auth Google and PRIVATE Storage, server-side calls only).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_project_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_private_service_role_key
APP_URL=http://localhost:3000

# Bootstrap admin and condominium
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=choose-a-unique-long-password
BOOTSTRAP_CONDO_NAME=Condomínio Piloto
BOOTSTRAP_CONDO_SLUG=piloto
BOOTSTRAP_INVITE_CODE=choose-a-unique-private-code

# Supabase Auth sends all confirmation/reset emails (configure SMTP in its dashboard).
# Recovery email template must use the /api/auth/recovery/verify endpoint.

# New condominium tower naming (existing condominiums are unchanged):
# letters: Torre A ... Torre AD; numbers: Torre 1 ... Torre 30
BOOTSTRAP_TOWER_FORMAT=letters
BOOTSTRAP_TOWER_COUNT=30

# Wildcard tenant routing: configure *.seu-dominio.com.br in DNS/proxy with wildcard TLS.
# Set both vars to the actual registered base domain (no protocol).
TENANT_BASE_DOMAIN=seu-dominio.com.br
NEXT_PUBLIC_TENANT_BASE_DOMAIN=seu-dominio.com.br

# Lightweight, privacy-safe API timing logs via PM2 (see docs/API_OBSERVABILITY.md).
API_METRICS_ENABLED=true
API_SLOW_REQUEST_MS=1000
API_METRICS_SAMPLE_RATE=0.02

# Required after applying 034_auth_api_hardening.sql. Server-only HMAC key
# to pseudonymize login/recovery/registration fingerprints (32+ random bytes).
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never put it into NEXT_PUBLIC_* or Git. Store in the deployment secret manager.
AUTH_RATE_LIMIT_SECRET=replace-with-a-random-64-character-hex-secret-not-this-value

# Public legal identification displayed on /politica-de-privacidade and /termos-de-uso.
# IMPORTANT: Complete with verified controller identity and monitored privacy email
# before launching the policies. These fields are PUBLIC, never secret credentials.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_REGISTRATION=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_PRIVACY_EMAIL=

# Native app compatibility (never expose private push credentials to the app).
# Legacy callback retained for already installed app versions and current Supabase allowlist.
# Do not change without coordinating a new app build and Auth redirect configuration.
MOBILE_AUTH_REDIRECT_URI=condovery://auth/callback
EXPO_PROJECT_ID=
PUSH_ENABLED=false
# Enable enhanced push security in the Expo project and use a server-only Expo token.
EXPO_ACCESS_TOKEN=

# Optional commercial contacts for the Elevadoor presentation page.
NEXT_PUBLIC_ELEVADOOR_SALES_WHATSAPP=
NEXT_PUBLIC_ELEVADOOR_SALES_EMAIL=
