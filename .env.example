# Backend-only connection from Supabase Dashboard > Connect.
# Use Session pooler (5432) for a persistent backend and Transaction pooler
# (6543) for serverless environments. Do not place these in NEXT_PUBLIC_*.
DATABASE_URL=postgresql://postgres.PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Supabase project (Auth Google and PRIVATE Storage, server-side calls only).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_project_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_private_service_role_key
APP_URL=http://localhost:3000

# Bootstrap admin and condominium
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=choose-a-unique-long-password
BOOTSTRAP_CONDO_NAME=Condomínio Piloto
BOOTSTRAP_CONDO_SLUG=piloto
BOOTSTRAP_INVITE_CODE=choose-a-unique-private-code

# Supabase Auth sends all confirmation/reset emails (configure SMTP in its dashboard).
# Recovery email template must use the /api/auth/recovery/verify endpoint.
